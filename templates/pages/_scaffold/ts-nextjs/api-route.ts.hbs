import { NextRequest, NextResponse } from "next/server";
import { getCloudflareContext } from "@opennextjs/cloudflare";
import { getDb } from "@/db";
import { {{entityName}} } from "@/db/schema/{{entityName}}";

// The `DB` binding isn't in @opennextjs/cloudflare's generic CloudflareEnv type until
// you run `wrangler types` (which reads it from wrangler.jsonc) — cast it here so this
// route compiles without that extra step; regenerate with `wrangler types` for real typing.
function db() {
  const { env } = getCloudflareContext();
  return getDb((env as unknown as { DB: D1Database }).DB);
}

export async function GET() {
  const rows = await db().select().from({{entityName}}).all();
  return NextResponse.json(rows);
}

export async function POST(request: NextRequest) {
  const body = (await request.json()) as typeof {{entityName}}.$inferInsert;
  const [row] = await db().insert({{entityName}}).values(body).returning();
  return NextResponse.json(row, { status: 201 });
}
