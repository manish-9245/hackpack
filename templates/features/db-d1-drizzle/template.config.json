{
  "name": "db-d1-drizzle",
  "type": "feature",
  "category": "db",
  "description": "Cloudflare D1 (SQLite) with Drizzle ORM",
  "compatibleWith": ["ts-nextjs", "ts-vite-react", "ts-sveltekit", "ts-hono-api"],
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "@cloudflare/workers-types": "^4.20250408.0"
  },
  "wiring": [
    {
      "file": "wrangler.jsonc",
      "anchor": "// hackpack:bindings",
      "insert": ",\n  \"d1_databases\": [{ \"binding\": \"DB\", \"database_name\": \"hackpack-db\", \"database_id\": \"REPLACE_WITH_ID_FROM_wrangler_d1_create\" }]"
    }
  ],
  "postInstall": []
}
