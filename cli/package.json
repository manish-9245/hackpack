{
  "name": "create-hackpack",
  "version": "1.0.1",
  "description": "CLI to scaffold full-stack hackathon projects in seconds. Pick a framework, add features (UI, auth, DB, AI), generate CRUD pages, deploy to Cloudflare Workers. Run with npx create-hackpack.",
  "keywords": [
    "hackathon",
    "scaffold",
    "scaffolding",
    "cli",
    "npx",
    "create",
    "generator",
    "project-generator",
    "full-stack",
    "nextjs",
    "react",
    "vite",
    "fastapi",
    "sveltekit",
    "svelte",
    "vue",
    "nuxt",
    "hono",
    "cloudflare-workers",
    "d1",
    "drizzle",
    "shadcn",
    "better-auth",
    "authentication",
    "crud-generator",
    "composable",
    "deterministic",
    "typescript",
    "python",
    "boilerplate",
    "starter-kit",
    "starter-template"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/manish-9245/hackpack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/manish-9245/hackpack.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/manish-9245/hackpack/issues",
  "author": "Manish Tiwari",
  "bin": {
    "hackpack": "./bin/hackpack.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md"
  ],
  "scripts": {
    "prepack": "rm -rf templates && cp -R ../templates ./templates",
    "postpack": "rm -rf templates",
    "selfcheck": "node --no-warnings test/self-check.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "citty": "^0.1.6",
    "compromise": "^14.14.4",
    "execa": "^9.5.2",
    "giget": "^3.3.1",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "tsx": "^4.18.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
