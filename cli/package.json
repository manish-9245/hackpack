{
  "name": "hackpack",
  "version": "0.1.0",
  "description": "Scaffold full-stack hackathon projects in seconds. Pick a framework, add features (UI, auth, DB, AI), generate CRUD pages, deploy to Cloudflare Workers.",
  "keywords": [
    "hackathon",
    "scaffold",
    "full-stack",
    "nextjs",
    "fastapi",
    "sveltekit",
    "hono",
    "cloudflare-workers",
    "d1",
    "authentication",
    "crud-generator",
    "composable",
    "deterministic",
    "typescript",
    "python",
    "project-generator",
    "boilerplate",
    "starter-template"
  ],
  "type": "module",
  "bin": {
    "hackpack": "./bin/hackpack.ts"
  },
  "scripts": {
    "selfcheck": "node --no-warnings test/self-check.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "citty": "^0.1.6",
    "compromise": "^14.14.4",
    "execa": "^9.5.2",
    "giget": "^3.3.1",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
